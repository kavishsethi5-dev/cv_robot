<?xml version="1.0"?>
<robot name="box">
<link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> <!-- -->
  </joint>


  <!-- Main chassis (box) -->
    <link name="base_link">
    <!-- Visual representation (what you see) -->
    <visual>
      <geometry>
        <box size="0.12 0.12 0.15"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1.0"/>
      </material>
    </visual>

    <!-- Collision representation (for physics and obstacles) -->
    <collision>
      <geometry>
        <box size="0.12 0.12 0.15"/>
      </geometry>
    </collision>

    <!-- yet to be calculated -->
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.024" ixy="0.0" ixz="0.0" iyy="0.086" iyz="0.0" izz="0.104"/>
    </inertial>
  </link>

   <!-- ArUco marker (overhead-camera localization ground truth) -->
  <link name="aruco_marker_link">
    <visual>
      <geometry>
        <mesh filename="package://cv_robot/materials/meshes/aruco4_marker.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="2.1e-7" ixy="0" ixz="0" iyy="2.1e-7" iyz="0" izz="4.1e-7"/>
    </inertial>
  </link>
  <joint name="aruco_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="aruco_marker_link"/>
    <origin xyz="0.0 0.0 0.08" rpy="0 0 0"/>
  </joint>
  </robot>
  